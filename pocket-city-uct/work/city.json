 "notes": [
  {
   "title": "Campus San Francisco",
   "text": "Campus de la UCT en Manuel Montt 56, entre Av. Alemania y Pasaje El Bosque. La disposición de jardines, árboles, cruz, anfiteatro, banderas, el pabellón de madera, el techo en diente de sierra del Aula Magna y la casa amarilla sigue la ilustración del campus del proyecto DGDC; huellas de los edificios desde OpenStreetMap. Pisos y colores son ilustrativos. Las canchas de tenis vecinas pertenecen al colegio contiguo, no al campus.",
   "links": [
    {
     "label": "Wikipedia",
     "url": "https://es.wikipedia.org/wiki/Universidad_Cat%C3%B3lica_de_Temuco"
    },
    {
     "label": "Proyecto DGDC",
     "url": "https://github.com/uctenis/dgdc"
    }
   ]
  },
  {
   "title": "Códigos DGDC",
   "text": "Edificio A = CSF16, B = CSF14, C = CSF12 (Edificio Teresa Durán), K = CSF17; la biblioteca es CSF02. Los edificios CSF14 a CSF16 tienen estructura de madera laminada en pilares y vigas (presupuesto DGDC 2026).",
   "links": [
    {
     "label": "Proyecto DGDC",
     "url": "https://github.com/uctenis/dgdc"
    }
   ]
  },
  {
   "title": "Casa Thiers",
   "text": "Casona de 1924 de dos pisos, diseñada por Carlos Caballero, sede del Museo Regional de la Araucanía y Monumento Histórico desde 1996. Sus tejas de arcilla se cambiaron por planchas metálicas en los años 70. La terraza de cuatro columnas y la escalinata se dibujan a partir de la descripción del decreto; su posición, el color de muros y la pendiente del techo son interpretados.",
   "links": [
    {
     "label": "Portal de Patrimonio",
     "url": "https://patrimonio.bienes.cl/patrimonio/museo-regional-de-la-araucania/"
    },
    {
     "label": "Diario Oficial (2024)",
     "url": "https://www.diariooficial.interior.gob.cl/publicaciones/2024/08/28/43936/01/2535649.pdf"
    },
    {
     "label": "Museo Regional",
     "url": "https://www.museoregionalaraucania.gob.cl/colecciones/casa-thiers-de-temuco"
    }
   ]
  },
  {
   "title": "Lo ilustrativo",
   "text": "Las secuoyas y tilos del parque Thiers tienen posición ilustrativa. Vehículos, personas, faroles, trayectos y fachadas siguen un estilo genérico de Temuco, no fotografías de cada edificio.",
   "links": [
    {
     "label": "Árboles de Temuco",
     "url": "https://core.ac.uk/download/75990686.pdf"
    }
   ]
  }
 ],
